{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push-gates.sh",
            "if": "Bash(git push*)",
            "timeout": 600,
            "statusMessage": "Running fmt, clippy and tests before push"
          }
        ]
      }
    ]
  }
}
